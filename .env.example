# ========================================================
# CI/CD Failure Analyzer - Environment Configuration
# ========================================================

# n8n Core Settings
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# For public webhook reception from GitHub:
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_32_character_key

# GitHub Integration
# Requires permissions: repo (or actions:read, actions:write, pull_requests:write)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenOrGitHubAppToken
GITHUB_WEBHOOK_SECRET=your_github_webhook_shared_secret

# AI Classifier Configuration (OpenAI / Anthropic / Gemini / Local Fallback)
# Leave blank to run purely in deterministic Heuristic mode (0 API cost)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Failure Analyzer & Retry Guardrails
MAX_AUTO_RETRIES=2
ENABLE_AUTO_RETRY=true
METRICS_LOG_PATH=./data/metrics.json
